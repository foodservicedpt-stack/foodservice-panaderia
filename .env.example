# Copia este archivo como .env (local) y configura estas mismas variables
# como Environment Variables en Vercel (Project Settings -> Environment Variables)

# Cadena de conexión de Postgres (Supabase: Project Settings -> Database -> Connection string -> URI)
DATABASE_URL="postgresql://usuario:password@host:5432/basededatos"

# Contraseña de acceso del equipo a la app
TEAM_PASSWORD="cambia-esta-contrasena"

# Secreto usado para firmar sesiones/autenticación - genera uno nuevo y aleatorio
AUTH_SECRET="genera-un-secreto-aleatorio-largo-aqui"
